#!/usr/bin/env node
// Fake `delta` for tests. State lives in PI_FAKE_DELTA_DIR.
// PI_FAKE_DELTA_FAIL=1: append exits retryable before writing.
// PI_FAKE_DELTA_PARTIAL=1: records the first line, then exits retryable.
// PI_FAKE_DELTA_PERMANENT=1: append exits non-retryable before writing.
import fs from "node:fs";
import path from "node:path";

const dir = process.env.PI_FAKE_DELTA_DIR;
if (!dir) {
	console.error("PI_FAKE_DELTA_DIR unset");
	process.exit(1);
}
const file = path.join(dir, "state.json");
const state = fs.existsSync(file)
	? JSON.parse(fs.readFileSync(file, "utf8"))
	: { threadId: "thread_test", log: [], producers: {}, appends: 0 };
state.producers ??= {};
state.appends ??= 0;
const save = () => fs.writeFileSync(file, JSON.stringify(state));

const args = process.argv.slice(2);
const sub = args[1];
const externalId = () => {
	const index = args.indexOf("--external-id");
	return index >= 0 ? args[index + 1] : "default";
};
const producer = () => (state.producers[externalId()] ??= { next: 1 });

function fail(message, extra = {}) {
	console.log(JSON.stringify({ error: { message, ...extra } }));
	process.exit(1);
}
function receipt(record, next, disposition) {
	return {
		operation: "appended",
		thread_id: state.threadId,
		sequence: record.sequence,
		next_sequence: next,
		duplicate: disposition === "duplicate",
		version: "8",
		disposition,
		turn_sequence: record.turnSequence ?? null,
	};
}

if (args[0] === "org" && sub === "list") {
	console.log(JSON.stringify({ organizations: [{ id: "org_test", current: true }] }));
	process.exit(0);
}
if (args[0] === "thread" && sub === "contract") {
	console.log(JSON.stringify({ min: 8, max: 8 }));
	process.exit(0);
}
if (args[0] === "thread" && sub === "create") {
	save();
	console.log(JSON.stringify({ operation: "created", thread_id: state.threadId, created: true }));
	process.exit(0);
}
if (args[0] === "thread" && sub === "status") {
	console.log(JSON.stringify({ producer: { next_sequence: producer().next }, url: "https://delta.example/t", title: state.title ?? null }));
	process.exit(0);
}
if (args[0] === "thread" && sub === "append") {
	state.appends += 1;
	save();
	if (process.env.PI_FAKE_DELTA_PERMANENT === "1") fail("reload the thread", { code: "reload_required", retryable: false });
	if (process.env.PI_FAKE_DELTA_FAIL === "1") fail("fake down", { retryable: true });
	const records = fs.readFileSync(0, "utf8").split("\n").filter(Boolean).map((line) => JSON.parse(line));
	const limit = process.env.PI_FAKE_DELTA_PARTIAL === "1" ? 1 : records.length;
	const cursor = producer();
	for (let i = 0; i < records.length && i < limit; i++) {
		const record = records[i];
		if (record.schemaVersion !== 1 || typeof record.update?.sessionUpdate !== "string") {
			fail(`bad record sequence ${record.sequence}`, { code: "invalid_record", retryable: false });
		}
		if (record.sequence < cursor.next) {
			console.log(JSON.stringify(receipt(record, cursor.next, "duplicate")));
			continue;
		}
		if (record.sequence !== cursor.next) {
			fail(`bad record sequence ${record.sequence}, expected ${cursor.next}`, { code: "sequence_gap", retryable: false });
		}
		if (record.update.sessionUpdate === "session_info_update") state.title = record.update.title;
		state.log.push(record);
		cursor.next += 1;
		save();
		console.log(JSON.stringify(receipt(record, cursor.next, "recorded")));
	}
	if (limit < records.length) fail("partial", { retryable: true });
	process.exit(0);
}
console.log(JSON.stringify({ error: { message: `unhandled ${args.join(" ")}` } }));
process.exit(1);
